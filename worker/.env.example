# Copy to .env for local dev. On Railway, set these as service variables instead.

# Shared secret the website sends when triggering a job; generate any random string.
WORKER_SHARED_SECRET=

# Cloudflare R2 (same bucket/account as the website)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clipboard-coach-videos
R2_PUBLIC_URL=

# Supabase (Project Settings > API) - service role key, bypasses RLS
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Official Voetbal Vlaanderen/RBFA calendar API access.
RBFA_API_USERNAME=
RBFA_API_PASSWORD=
RBFA_GRAPHQL_URL=https://datalake-prod2018.rbfa.be/graphql

PORT=8080
