# Copy this file to .env.local and fill in real values.
# See website/README.md for where each of these comes from.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (dash.cloudflare.com > R2 > Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clipboard-coach-videos
R2_PUBLIC_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Video processing worker (Railway) - leave blank to skip background
# compression and keep playing videos straight from the raw R2 upload.
WORKER_URL=
WORKER_SHARED_SECRET=

# --- Not needed yet, added in a later phase ---
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
